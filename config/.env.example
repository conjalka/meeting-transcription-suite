# Copy to %USERPROFILE%\Documents\TranscriptionSuite\docker\.env and fill in.
# Never commit the real .env file.

# Hugging Face read token. Required for speaker diarization (PyAnnote).
# Create one at https://huggingface.co/settings/tokens and accept the terms for
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0 on Hugging Face.
HUGGINGFACE_TOKEN=

DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
